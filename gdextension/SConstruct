#!/usr/bin/env python
import os
import sys

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/public"])
env.Append(CPPDEFINES=["ORC_RENDERER_EXPORTS"])
    
env['OBJSUFFIX'] = '.o'

# Compile ORC framework sources
src_dir = "src/private"
obj_dir = "obj"
VariantDir(obj_dir, src_dir, duplicate=0)
sources = Glob(os.path.join(obj_dir, "*.cpp"))

# Compile C++ implementations from src/impl/
impl_dir = "src/impl"
if os.path.exists(impl_dir):
    for impl_name in os.listdir(impl_dir):
        impl_path = os.path.join(impl_dir, impl_name)
        if os.path.isdir(impl_path) and impl_name != ".gitkeep":
            # Add all subdirectories recursively to include path for maximum flexibility
            for root, dirs, files in os.walk(impl_path):
                env.Append(CPPPATH=[root])
            
            # Define macro for this implementation
            impl_define = "ORC_IMPL_" + impl_name.upper().replace("-", "_")
            env.Append(CPPDEFINES=[impl_define])
            
            # Compile all .cpp files recursively from the implementation directory
            impl_obj_dir = os.path.join(obj_dir, "impl", impl_name)
            for root, dirs, files in os.walk(impl_path):
                cpp_files = [f for f in files if f.endswith('.cpp')]
                if cpp_files:
                    rel_path = os.path.relpath(root, impl_path)
                    obj_subdir = os.path.join(impl_obj_dir, rel_path) if rel_path != '.' else impl_obj_dir
                    VariantDir(obj_subdir, root, duplicate=0)
                    sources += Glob(os.path.join(obj_subdir, "*.cpp"))
            
            print(f"Adding C++ implementation: {impl_name} (define: {impl_define})")

if env["target"] == "template_debug":
    print("Building with test sources (DEBUG build)")
    tests_dir = "src/tests"
    # Compile all .cpp files recursively from the tests directory
    for root, dirs, files in os.walk(tests_dir):
        cpp_files = [f for f in files if f.endswith('.cpp')]
        if cpp_files:
            rel_path = os.path.relpath(root, tests_dir)
            obj_subdir = os.path.join(obj_dir, "tests", rel_path) if rel_path != '.' else os.path.join(obj_dir, "tests")
            VariantDir(obj_subdir, root, duplicate=0)
            sources += Glob(os.path.join(obj_subdir, "*.cpp"))
        # Add all subdirectories to include path
        env.Append(CPPPATH=[root])

    print("Building with dbg sources (DEBUG build)")
    dbg_dir = "src/dbg"
    VariantDir(os.path.join(obj_dir, "dbg"), dbg_dir, duplicate=0)
    sources += Glob(os.path.join(obj_dir, "dbg", "*.cpp"))
    env.Append(CPPPATH=[dbg_dir])

library = env.SharedLibrary(
    "bin/liborc{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

Default(library)
