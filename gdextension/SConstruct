#!/usr/bin/env python
import os
import sys

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/public"])
env.Append(CPPDEFINES=["ORC_RENDERER_EXPORTS"])
    
env['OBJSUFFIX'] = '.o'

# Compile ORC framework sources
src_dir = "src/private"
obj_dir = "obj"
VariantDir(obj_dir, src_dir, duplicate=0)
sources = Glob(os.path.join(obj_dir, "*.cpp"))

# Compile C++ implementations from src/impl/
impl_dir = "src/impl"
if os.path.exists(impl_dir):
    for impl_name in os.listdir(impl_dir):
        impl_path = os.path.join(impl_dir, impl_name)
        if os.path.isdir(impl_path) and impl_name != ".gitkeep":
            # Add public headers to include path
            impl_public = os.path.join(impl_path, "public")
            if os.path.exists(impl_public):
                env.Append(CPPPATH=[impl_public])
            
            # Define macro for this implementation
            impl_define = "ORC_IMPL_" + impl_name.upper().replace("-", "_")
            env.Append(CPPDEFINES=[impl_define])
            
            # Compile implementation .cpp files
            impl_obj_dir = os.path.join(obj_dir, "impl", impl_name)
            VariantDir(impl_obj_dir, impl_path, duplicate=0)
            sources += Glob(os.path.join(impl_obj_dir, "*.cpp"))
            
            print(f"Adding C++ implementation: {impl_name} (define: {impl_define})")

if env["target"] == "template_debug":
    print("Building with test sources (DEBUG build)")
    tests_dir = "src/tests"
    VariantDir(os.path.join(obj_dir, "tests"), tests_dir, duplicate=0)
    sources += Glob(os.path.join(obj_dir, "tests", "*.cpp"))
    env.Append(CPPPATH=[tests_dir])

    print("Building with dbg sources (DEBUG build)")
    dbg_dir = "src/dbg"
    VariantDir(os.path.join(obj_dir, "dbg"), dbg_dir, duplicate=0)
    sources += Glob(os.path.join(obj_dir, "dbg", "*.cpp"))
    env.Append(CPPPATH=[dbg_dir])

library = env.SharedLibrary(
    "bin/liborc{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

Default(library)
